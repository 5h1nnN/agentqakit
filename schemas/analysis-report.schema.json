{
  "$defs": {
    "EvidenceReference": {
      "additionalProperties": false,
      "description": "Stable reference retained in an analysis report without full raw evidence.",
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "scenario",
            "target",
            "manifest",
            "evaluation",
            "state",
            "tool",
            "error",
            "trace"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "source_ref",
        "content_hash",
        "summary"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "JsonValue": {},
    "LLMCallEvidence": {
      "additionalProperties": false,
      "description": "Non-secret, reproducible metadata for one logical structured LLM call.",
      "properties": {
        "attempts": {
          "exclusiveMinimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "evidence_hash": {
          "minLength": 1,
          "title": "Evidence Hash",
          "type": "string"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "prompt_hash": {
          "minLength": 1,
          "title": "Prompt Hash",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "provider_request_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Provider Request Ids",
          "type": "array"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "response_schema_hash": {
          "minLength": 1,
          "title": "Response Schema Hash",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "INVALID_OUTPUT",
            "PROVIDER_ERROR",
            "SKIPPED"
          ],
          "title": "Status",
          "type": "string"
        },
        "system_prompt_hash": {
          "minLength": 1,
          "title": "System Prompt Hash",
          "type": "string"
        },
        "token_usage": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "maxProperties": 20,
          "title": "Token Usage",
          "type": "object"
        },
        "transport_attempts": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport Attempts"
        },
        "use_case": {
          "enum": [
            "test_generation",
            "semantic_judge",
            "failure_analysis"
          ],
          "title": "Use Case",
          "type": "string"
        }
      },
      "required": [
        "use_case",
        "provider",
        "model",
        "parameters",
        "system_prompt_hash",
        "prompt_hash",
        "evidence_hash",
        "response_schema_hash",
        "request_id",
        "attempts",
        "status"
      ],
      "title": "LLMCallEvidence",
      "type": "object"
    },
    "ObservedFact": {
      "additionalProperties": false,
      "description": "A direct observation with explicit evidence references.",
      "properties": {
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "statement": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "evidence_ids"
      ],
      "title": "ObservedFact",
      "type": "object"
    },
    "RegressionTestSuggestion": {
      "additionalProperties": false,
      "description": "Suggested future test, not an automatically executable specification.",
      "properties": {
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "expected_behavior": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Expected Behavior",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "title": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "rationale",
        "expected_behavior",
        "evidence_ids"
      ],
      "title": "RegressionTestSuggestion",
      "type": "object"
    },
    "RootCauseCandidate": {
      "additionalProperties": false,
      "description": "Non-authoritative root cause hypothesis grounded in evidence.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "counter_evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Counter Evidence Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "hypothesis": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Hypothesis",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "reasoning": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reasoning",
          "type": "string"
        }
      },
      "required": [
        "id",
        "hypothesis",
        "confidence",
        "evidence_ids",
        "reasoning"
      ],
      "title": "RootCauseCandidate",
      "type": "object"
    },
    "TrajectoryDivergence": {
      "additionalProperties": false,
      "description": "Earliest observed anomaly or departure from an expected trajectory.",
      "properties": {
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "span_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        }
      },
      "required": [
        "description",
        "evidence_ids"
      ],
      "title": "TrajectoryDivergence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Separate, non-authoritative explanation of one immutable failed trial.",
  "properties": {
    "analysis_id": {
      "minLength": 1,
      "title": "Analysis Id",
      "type": "string"
    },
    "earliest_divergence": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrajectoryDivergence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evaluation_statuses": {
      "maxProperties": 20,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._-]*$": {
          "minLength": 1,
          "type": "string"
        }
      },
      "propertyNames": {
        "maxLength": 128,
        "minLength": 1
      },
      "title": "Evaluation Statuses",
      "type": "object"
    },
    "evidence_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence Hash",
      "type": "string"
    },
    "evidence_index": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Evidence Index",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "llm_call": {
      "$ref": "#/$defs/LLMCallEvidence"
    },
    "missing_evidence": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Missing Evidence",
      "type": "array"
    },
    "observed_facts": {
      "items": {
        "$ref": "#/$defs/ObservedFact"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Observed Facts",
      "type": "array"
    },
    "original_passed": {
      "const": false,
      "title": "Original Passed",
      "type": "boolean"
    },
    "regression_tests": {
      "items": {
        "$ref": "#/$defs/RegressionTestSuggestion"
      },
      "maxItems": 20,
      "title": "Regression Tests",
      "type": "array"
    },
    "repair_directions": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Repair Directions",
      "type": "array"
    },
    "root_causes": {
      "items": {
        "$ref": "#/$defs/RootCauseCandidate"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Root Causes",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "agentqa.analysis-report/v1alpha1",
      "default": "agentqa.analysis-report/v1alpha1",
      "title": "Schema Version",
      "type": "string"
    },
    "test_case_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Test Case Id",
      "type": "string"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "trial_id": {
      "minLength": 1,
      "title": "Trial Id",
      "type": "string"
    }
  },
  "required": [
    "analysis_id",
    "generated_at",
    "run_id",
    "test_case_id",
    "trial_id",
    "trace_id",
    "original_passed",
    "evaluation_statuses",
    "evidence_hash",
    "evidence_index",
    "observed_facts",
    "root_causes",
    "llm_call"
  ],
  "title": "AnalysisReport",
  "type": "object"
}
