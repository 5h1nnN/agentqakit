# Copy to .env.local, keep permissions at 600, and never commit the real key.
AGENTQA_LLM_API_KEY=
AGENTQA_LLM_BASE_URL=https://api.deepseek.com
AGENTQA_LLM_MODEL=your-deepseek-model

# Optional bounded transport settings.
AGENTQA_LLM_TIMEOUT_SECONDS=60
AGENTQA_LLM_MAX_TOKENS=1024
AGENTQA_LLM_TEMPERATURE=0
AGENTQA_LLM_RETRY_BACKOFF_SECONDS=0.5

# Legacy AGENTQA_JUDGE_* names remain accepted for backward compatibility.
