# Copy to .env.local, keep permissions at 600, and never commit the real key.
AGENTQA_JUDGE_API_KEY=
AGENTQA_JUDGE_BASE_URL=https://api.deepseek.com
AGENTQA_JUDGE_MODEL=your-deepseek-model

# Optional bounded transport settings.
AGENTQA_JUDGE_TIMEOUT_SECONDS=60
AGENTQA_JUDGE_MAX_TOKENS=1024
AGENTQA_JUDGE_TEMPERATURE=0
AGENTQA_JUDGE_RETRY_BACKOFF_SECONDS=0.5
