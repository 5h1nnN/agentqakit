{
  "$defs": {
    "ErrorInfo": {
      "additionalProperties": false,
      "description": "A safe, structured failure without an attached traceback.",
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "EvaluationResult": {
      "additionalProperties": false,
      "description": "Outcome from one evaluator.",
      "properties": {
        "evaluator_type": {
          "minLength": 1,
          "title": "Evaluator Type",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "ERROR",
            "SKIPPED",
            "NOT_OBSERVABLE",
            "NEEDS_REVIEW"
          ],
          "title": "Status",
          "type": "string"
        },
        "violations": {
          "items": {
            "$ref": "#/$defs/Violation"
          },
          "title": "Violations",
          "type": "array"
        }
      },
      "required": [
        "evaluator_type",
        "status"
      ],
      "title": "EvaluationResult",
      "type": "object"
    },
    "InterceptionPoint": {
      "additionalProperties": false,
      "description": "A named runtime boundary at which a mutation can be applied.",
      "properties": {
        "kind": {
          "enum": [
            "tool",
            "retriever",
            "http"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "InterceptionPoint",
      "type": "object"
    },
    "JsonValue": {},
    "MutationApplication": {
      "additionalProperties": false,
      "description": "Evidence emitted for one active-mutation interception attempt.",
      "properties": {
        "applied_at": {
          "format": "date-time",
          "title": "Applied At",
          "type": "string"
        },
        "behavior": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Behavior",
          "type": "object"
        },
        "call_index": {
          "minimum": 1,
          "title": "Call Index",
          "type": "integer"
        },
        "interception": {
          "$ref": "#/$defs/InterceptionPoint"
        },
        "invocation_summary": {
          "$ref": "#/$defs/JsonValue"
        },
        "match": {
          "$ref": "#/$defs/MutationMatch"
        },
        "mutation_id": {
          "minLength": 1,
          "title": "Mutation Id",
          "type": "string"
        },
        "operation_type": {
          "minLength": 1,
          "title": "Operation Type",
          "type": "string"
        },
        "result_summary": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "span_id": {
          "minLength": 1,
          "title": "Span Id",
          "type": "string"
        },
        "test_case_id": {
          "minLength": 1,
          "title": "Test Case Id",
          "type": "string"
        },
        "trace_id": {
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        },
        "trial_id": {
          "minLength": 1,
          "title": "Trial Id",
          "type": "string"
        },
        "triggered": {
          "title": "Triggered",
          "type": "boolean"
        }
      },
      "required": [
        "mutation_id",
        "operation_type",
        "interception",
        "call_index",
        "triggered",
        "match",
        "invocation_summary",
        "test_case_id",
        "trial_id",
        "trace_id",
        "span_id",
        "applied_at"
      ],
      "title": "MutationApplication",
      "type": "object"
    },
    "MutationMatch": {
      "additionalProperties": false,
      "description": "Deterministic condition-by-condition matcher decision.",
      "properties": {
        "conditions": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Conditions",
          "type": "object"
        },
        "matched": {
          "title": "Matched",
          "type": "boolean"
        },
        "mutation_id": {
          "minLength": 1,
          "title": "Mutation Id",
          "type": "string"
        },
        "probability_sample": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probability Sample"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "mutation_id",
        "matched"
      ],
      "title": "MutationMatch",
      "type": "object"
    },
    "ReplayStats": {
      "additionalProperties": false,
      "description": "Per-trial record/replay accounting persisted with the test result.",
      "properties": {
        "hit_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hit Rate"
        },
        "hits": {
          "minimum": 0,
          "title": "Hits",
          "type": "integer"
        },
        "live_fallbacks": {
          "minimum": 0,
          "title": "Live Fallbacks",
          "type": "integer"
        },
        "misses": {
          "minimum": 0,
          "title": "Misses",
          "type": "integer"
        },
        "mode": {
          "enum": [
            "off",
            "record",
            "replay"
          ],
          "title": "Mode",
          "type": "string"
        },
        "recorded": {
          "minimum": 0,
          "title": "Recorded",
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "recorded",
        "hits",
        "misses",
        "live_fallbacks"
      ],
      "title": "ReplayStats",
      "type": "object"
    },
    "TargetResult": {
      "additionalProperties": false,
      "description": "Normalized output from any target adapter.",
      "properties": {
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "output": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "raw_response_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Response Ref"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "OK",
            "ERROR",
            "TIMEOUT"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "started_at",
        "ended_at"
      ],
      "title": "TargetResult",
      "type": "object"
    },
    "Violation": {
      "additionalProperties": false,
      "description": "A concrete failed assertion with optional trace evidence.",
      "properties": {
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "span_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "title": "Violation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Combined target and evaluator result for one test trial.",
  "properties": {
    "cassette_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cassette Ref"
    },
    "ended_at": {
      "format": "date-time",
      "title": "Ended At",
      "type": "string"
    },
    "evaluations": {
      "items": {
        "$ref": "#/$defs/EvaluationResult"
      },
      "title": "Evaluations",
      "type": "array"
    },
    "failure_bundle_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Bundle Ref"
    },
    "mutation_applications": {
      "items": {
        "$ref": "#/$defs/MutationApplication"
      },
      "title": "Mutation Applications",
      "type": "array"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "replay": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReplayStats"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scores": {
      "additionalProperties": {
        "maximum": 1.0,
        "minimum": 0.0,
        "type": "number"
      },
      "title": "Scores",
      "type": "object"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "target_result": {
      "$ref": "#/$defs/TargetResult"
    },
    "test_case_id": {
      "minLength": 1,
      "title": "Test Case Id",
      "type": "string"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "trace_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Ref"
    },
    "trace_status": {
      "default": "missing",
      "enum": [
        "complete",
        "partial",
        "missing"
      ],
      "title": "Trace Status",
      "type": "string"
    },
    "trial_id": {
      "minLength": 1,
      "title": "Trial Id",
      "type": "string"
    },
    "trial_index": {
      "exclusiveMinimum": 0,
      "title": "Trial Index",
      "type": "integer"
    },
    "trial_seed": {
      "title": "Trial Seed",
      "type": "integer"
    },
    "violations": {
      "items": {
        "$ref": "#/$defs/Violation"
      },
      "title": "Violations",
      "type": "array"
    }
  },
  "required": [
    "test_case_id",
    "trial_id",
    "trace_id",
    "trial_index",
    "trial_seed",
    "started_at",
    "ended_at",
    "passed",
    "target_result"
  ],
  "title": "TestResult",
  "type": "object"
}
