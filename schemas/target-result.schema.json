{
  "$defs": {
    "ErrorInfo": {
      "additionalProperties": false,
      "description": "A safe, structured failure without an attached traceback.",
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "Normalized output from any target adapter.",
  "properties": {
    "ended_at": {
      "format": "date-time",
      "title": "Ended At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "output": {
      "$ref": "#/$defs/JsonValue",
      "default": null
    },
    "raw_response_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Response Ref"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "OK",
        "ERROR",
        "TIMEOUT"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "started_at",
    "ended_at"
  ],
  "title": "TargetResult",
  "type": "object"
}
