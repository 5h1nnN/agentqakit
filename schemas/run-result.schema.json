{
  "$defs": {
    "ErrorInfo": {
      "additionalProperties": false,
      "description": "A safe, structured failure without an attached traceback.",
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "EvaluationResult": {
      "additionalProperties": false,
      "description": "Outcome from one evaluator.",
      "properties": {
        "evaluator_type": {
          "minLength": 1,
          "title": "Evaluator Type",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "ERROR",
            "SKIPPED",
            "NOT_OBSERVABLE",
            "NEEDS_REVIEW"
          ],
          "title": "Status",
          "type": "string"
        },
        "violations": {
          "items": {
            "$ref": "#/$defs/Violation"
          },
          "title": "Violations",
          "type": "array"
        }
      },
      "required": [
        "evaluator_type",
        "status"
      ],
      "title": "EvaluationResult",
      "type": "object"
    },
    "JsonValue": {},
    "RunSummary": {
      "additionalProperties": false,
      "description": "Recomputable aggregate counts for one run.",
      "properties": {
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "pass_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Pass Rate",
          "type": "number"
        },
        "passed": {
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "passed",
        "failed",
        "pass_rate"
      ],
      "title": "RunSummary",
      "type": "object"
    },
    "TargetResult": {
      "additionalProperties": false,
      "description": "Normalized output from any target adapter.",
      "properties": {
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "output": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "raw_response_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Response Ref"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "OK",
            "ERROR",
            "TIMEOUT"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "started_at",
        "ended_at"
      ],
      "title": "TargetResult",
      "type": "object"
    },
    "TestResult": {
      "additionalProperties": false,
      "description": "Combined target and evaluator result for one test trial.",
      "properties": {
        "evaluations": {
          "items": {
            "$ref": "#/$defs/EvaluationResult"
          },
          "title": "Evaluations",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "scores": {
          "additionalProperties": {
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          },
          "title": "Scores",
          "type": "object"
        },
        "target_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "test_case_id": {
          "minLength": 1,
          "title": "Test Case Id",
          "type": "string"
        },
        "trace_id": {
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        },
        "trial_id": {
          "minLength": 1,
          "title": "Trial Id",
          "type": "string"
        },
        "violations": {
          "items": {
            "$ref": "#/$defs/Violation"
          },
          "title": "Violations",
          "type": "array"
        }
      },
      "required": [
        "test_case_id",
        "trial_id",
        "trace_id",
        "passed"
      ],
      "title": "TestResult",
      "type": "object"
    },
    "Violation": {
      "additionalProperties": false,
      "description": "A concrete failed assertion with optional trace evidence.",
      "properties": {
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "span_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "title": "Violation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Final state and all trial results for a run.",
  "properties": {
    "ended_at": {
      "format": "date-time",
      "title": "Ended At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "results": {
      "items": {
        "$ref": "#/$defs/TestResult"
      },
      "title": "Results",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/RunSummary"
    }
  },
  "required": [
    "run_id",
    "status",
    "started_at",
    "ended_at",
    "summary"
  ],
  "title": "RunResult",
  "type": "object"
}
