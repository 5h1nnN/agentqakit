{
  "$defs": {
    "MutationOutcome": {
      "additionalProperties": false,
      "description": "One mutation's classification across all associated test trials.",
      "properties": {
        "failed_test_case_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Failed Test Case Ids",
          "type": "array"
        },
        "mutation_id": {
          "minLength": 1,
          "title": "Mutation Id",
          "type": "string"
        },
        "operation_type": {
          "minLength": 1,
          "title": "Operation Type",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "enum": [
            "KILLED",
            "SURVIVED",
            "NOT_REACHED",
            "INVALID"
          ],
          "title": "Status",
          "type": "string"
        },
        "target_kind": {
          "minLength": 1,
          "title": "Target Kind",
          "type": "string"
        },
        "test_case_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Test Case Ids",
          "type": "array"
        },
        "triggered_count": {
          "default": 0,
          "minimum": 0,
          "title": "Triggered Count",
          "type": "integer"
        }
      },
      "required": [
        "mutation_id",
        "operation_type",
        "target_kind",
        "status"
      ],
      "title": "MutationOutcome",
      "type": "object"
    },
    "MutationScoreBucket": {
      "additionalProperties": false,
      "description": "Recomputable counts and score for a group of mutation outcomes.",
      "properties": {
        "invalid": {
          "default": 0,
          "minimum": 0,
          "title": "Invalid",
          "type": "integer"
        },
        "killed": {
          "default": 0,
          "minimum": 0,
          "title": "Killed",
          "type": "integer"
        },
        "not_reached": {
          "default": 0,
          "minimum": 0,
          "title": "Not Reached",
          "type": "integer"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "survived": {
          "default": 0,
          "minimum": 0,
          "title": "Survived",
          "type": "integer"
        }
      },
      "title": "MutationScoreBucket",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Overall and per-operation mutation score report.",
  "properties": {
    "by_operation": {
      "additionalProperties": {
        "$ref": "#/$defs/MutationScoreBucket"
      },
      "title": "By Operation",
      "type": "object"
    },
    "outcomes": {
      "items": {
        "$ref": "#/$defs/MutationOutcome"
      },
      "title": "Outcomes",
      "type": "array"
    },
    "overall": {
      "$ref": "#/$defs/MutationScoreBucket"
    }
  },
  "required": [
    "overall"
  ],
  "title": "MutationScoreReport",
  "type": "object"
}
